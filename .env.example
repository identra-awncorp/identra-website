# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Public canonical origin used by SEO, sitemap, and social previews.
VITE_SITE_URL="https://www.identra.id.vn"

# VITE_IDENTRA_API_URL: Origin of the Identra API used by the sample university portal and the
# sample employer demo. Defaults to https://api-identra.awncorp.vn. Must be https, except plain http
# on 127.0.0.1 / localhost for local work, e.g. the development stand-in (npm run dev:api):
# VITE_IDENTRA_API_URL="http://127.0.0.1:47310"

# IDENTRA_ROOT_CA_FILE: Optional path to the Identra Root CA certificate (PEM) whose SHA-256
# fingerprint the Security page publishes. Defaults to src/identra/trust/root-ca.pem. A production
# build fails when the file is missing; the dev server shows a "not configured" state instead.
# IDENTRA_ROOT_CA_FILE="src/identra/trust/root-ca.pem"
