# Identra website: static hosting behind nginx (ADR-0016 section 5).
#
# Traffic path: Cloudflare (TLS) -> cloudflared -> nginx on 127.0.0.1:80 -> files in
# /srv/awncorp/identra-web (the contents of `dist/` after `npm run build`).
# Include this file inside the `http {}` context (e.g. sites-enabled); the `map` blocks must live there.
# The two rules that used to live in vercel.json are translated below and marked "from vercel.json".
#
# Layout produced by the build (see scripts/generate-localized-pages.ts):
#   /index.html                      neutral root entry (picks a saved locale via /root-locale.js)
#   /{locale}/index.html             locale home pages; locales: en es ja de vi
#   /{locale}/{view}/index.html      pages, e.g. /vi/blog/index.html, /vi/school-portal/index.html
#   /{locale}/demo/{id}/index.html   demo scenarios
#   /{locale}/404/index.html         localized not-found pages; /404.html is the neutral one
#   /product/index.html              the product page shell for every /01/ path (its own build, vite.product.config.ts)
#   /assets/*                        content-hashed JS/CSS/images (safe to cache forever)
#   /trust/identra-root-ca.pem       the published Identra Root CA certificate (and -next.pem in a rollover)

map $uri $identra_cache_control {
    default                                "public, max-age=3600";
    ~^/assets/                             "public, max-age=31536000, immutable";
    # no-transform on HTML: Cloudflare then leaves the page alone (it otherwise injects its Web
    # Analytics beacon script, which the Content-Security-Policy below blocks on every page load).
    ~\.html$                               "no-cache, no-transform";
    /                                      "no-cache, no-transform";
    /root-locale.js                        "no-cache";
    /trust/identra-root-ca.pem             "no-cache";
    /trust/identra-root-ca-next.pem        "no-cache";
    /sitemap.xml                           "no-cache";
    /blog-feed.xml                         "no-cache";
    # from vercel.json: the unlisted book shortcut must never be cached.
    /vi/self-sovereign-identity-book       "no-store";
}

# HTTP Link headers per file (none at the moment; the white paper and its PDF were withdrawn).
map $uri $identra_link_header {
    default                                    "";
}

# Target of the trailing-slash redirect, built from the raw request line ($request_uri: percent-encoded
# exactly as the client sent it, query string included), never from the decoded $uri, so no decoded byte
# (CR, LF, NUL, a backslash, ...) can reach the Location header. Empty when the raw path does not itself
# end in "/" (e.g. /vi/blog%2F, which decodes to a trailing slash): that request gets a 404, not a redirect.
map $request_uri $identra_without_trailing_slash {
    default                                                        "";
    "~^(?<identra_path>/[^?]*?)/+(?<identra_query>\?.*)?$"         $identra_path$identra_query;
}

# Unknown paths get the not-found page of the locale they were asked in.
map $uri $identra_not_found_page {
    default          /404.html;
    ~^/(en|es|ja|de|vi)(/|$)  /$1/404/index.html;
}

server {
    listen 127.0.0.1:80;
    server_name identra.awncorp.vn;
    root /srv/awncorp/identra-web;
    index index.html;

    server_tokens off;
    charset utf-8;

    # Security headers. nginx drops every server-level add_header in a location that has its own
    # add_header, so the one such location below (the root certificates) repeats this whole block;
    # keep the two copies identical.
    # Content-Security-Policy, verified with zero violations against the built site in Chromium:
    # - script-src 'self' only: no inline script (the locale bootstrap is /root-locale.js; JSON-LD blocks
    #   are data, not script, and are not governed by script-src).
    # - style-src-elem keeps 'unsafe-inline' for the first-paint skeleton <style>; style-src-attr for the
    #   style="" attributes React and motion write. Fonts' CSS comes from Google Fonts.
    # - img-src: the two image hosts the current pages use (Unsplash, Google user content).
    # - connect-src: the Identra API only.
    # HSTS is honoured by browsers only over HTTPS, which Cloudflare terminates in front of this server.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://lh3.googleusercontent.com; connect-src https://api-identra.awncorp.vn; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=()" always;
    add_header Cache-Control $identra_cache_control always;
    add_header Link $identra_link_header always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

    # A decoded path that starts with "//" or "/\" (e.g. /%5Cevil.example/) is never redirected anywhere.
    location ~ "^/(/|\x5C)" {
        return 404;
    }

    # Like vercel.json "trailingSlash": false: /vi/blog/ -> /vi/blog (the root "/" is left alone).
    # The target is absolute and on this host only, so no path can turn it into an off-site redirect, and
    # it comes from the raw request line (see the map above). /01/ paths never get here: `^~ /01/` below
    # is a prefix match that stops the regex search, so /01/<GTIN>/21/<serial>/ gets the product shell
    # (which shows "invalid code").
    location ~ ^(.+)/$ {
        if ($identra_without_trailing_slash = "") {
            return 404;
        }
        return 308 https://identra.awncorp.vn$identra_without_trailing_slash;
    }

    # from vercel.json: temporary redirect of the unlisted Vietnamese book shortcut (no-store via the map).
    # Only /vi; the same slug in other locales or without a locale falls through to a 404.
    location = /vi/self-sovereign-identity-book {
        return 307 https://drive.google.com/file/d/1thNJd9UMxk4glzgrQmmTsZ2fpCs8gIy-/view;
    }

    # The published Identra Root CA certificate(s): the current root and, during a rollover, the next.
    location ~ ^/trust/(identra-root-ca(-next)?\.pem)$ {
        default_type application/x-pem-file;
        add_header Content-Disposition "attachment" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://lh3.googleusercontent.com; connect-src https://api-identra.awncorp.vn; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=()" always;
        add_header Cache-Control $identra_cache_control always;
        try_files $uri =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # The product page (ADR-0012): the QR printed on a product is https://identra.awncorp.vn/01/<GTIN-14>/21/<serial>
    # (GS1 Digital Link). Every /01/ path gets the one prerendered shell (noindex, not in the sitemap);
    # the page parses the path with the SDK and shows "invalid code" for a malformed one. No other path
    # is affected. The server-level security headers apply (no add_header here).
    location ^~ /01/ {
        try_files /product/index.html =404;
    }

    location / {
        try_files $uri $uri/index.html =404;
    }

    error_page 404 $identra_not_found_page;
    location ~ ^/((en|es|ja|de|vi)/404/index\.html|404\.html)$ {
        internal;
    }
}
