{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/vi/self-sovereign-identity-book",
      "destination": "https://drive.google.com/file/d/1thNJd9UMxk4glzgrQmmTsZ2fpCs8gIy-/view",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/vi/self-sovereign-identity-book",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/white-paper/Identra-White-Paper-v1.0.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.identra.id.vn/vi/white-paper>; rel=\"canonical\""
        }
      ]
    }
  ]
}
